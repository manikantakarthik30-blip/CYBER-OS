# CYBER_OS Environment Configuration Example

# AI Intelligence & Threat Feeds
GEMINI_API_KEY=your_gemini_api_key_here
OSV_API_URL=https://api.osv.dev/v1
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
BACKEND_API_URL=http://localhost:8000

# Firebase Enclave (Optional)
FIREBASE_PROJECT_ID=your_firebase_project_id

# Google Cloud OAuth 2.0 (Optional - for custom Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP Email Dispatch Gateway (Optional - for live Gmail, SendGrid, or Brevo relay)
# Note: If left blank, CYBER_OS dispatches emails in Local Terminal Mode with automatic OTP display.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SENDER_EMAIL=security@cyber-os.io
